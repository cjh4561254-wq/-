# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- 密钥与本地配置（绝对不能进仓库）----
.env
.env.local

# ---- 运行时产生的数据（体积大且可重新生成）----
data/uploads/*
!data/uploads/.gitkeep
data/db/*.db
*.log

# ---- 安装过程的临时残留 ----
pip-unpack-*/
matplotlib-*/
.mplcache/

# ---- 测试与运行的临时产物 ----
# 根目录 conftest.py 已把 tempfile 指到 .tmp/（本机 Python 子进程写不进
# 系统临时目录，tempfile 会退回 cwd，也就是项目根目录）。
.tmp/
# 下面两条是"没被 conftest 拦住的漏网者"的最后一道保险：
# 万一将来有人在别的入口跑测试，也不会把随机名目录提交进仓库。
# 注意这里是**兜底**，不是解法 —— 解法是 conftest.py 里指向 .tmp/。
#
# 开头的 "/" 不能省：gitignore 里不带斜杠的 pattern 会在**任意层级**生效，
# 而这里的第 2 条本意只管项目根。实测（git check-ignore -v --no-index）：
#   不加 "/" 时会误伤 app/tmp_uploads/、data/tmp_uploads/ 这类真实工程目录；
#   加上 "/" 后它们不再被忽略，而根目录的随机名目录照旧被忽略。
# 另外 "?" 匹配任意字符（不只是数字），所以这条规则够宽，更要限定在根目录。
#
# 第 2 条原先是 `/tmp????????/`（**带尾斜杠**），那只匹配目录。实测（2026-10-13）：
#   tmpabcd1234/（目录）→ 被忽略 ✓
#   tmpefgh5678 （文件）→ 不忽略 ✗
# 而这个漏的正是最该拦的那种：Starlette 处理 >1MB 上传时用 SpooledTemporaryFile，
# 滚盘生成的是**文件** tmpXXXXXXXX，不是目录（见 docs/DECISIONS.md D-07）。
# 所以去掉尾斜杠（不带尾斜杠同时匹配文件与目录），并补一条带 `_N` 的：
# tempfile 撞名重试时会在后面接 `_1`/`_2`（实测见过 tmpwd4n6n_2）。
# 注意 `?` 是 8 个、不是通配任意长度 —— 随机名固定是 "tmp" + 8 个字符。
/pytest-of-*/
/tmp????????
/tmp????????_*

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
