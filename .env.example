# ============================================================
# 这个文件是**环境变量清单**，不是模板。
#
# 应用**不读它，也不读 `.env`**：配置来源只有进程的环境变量
# （见 README 的「配置」一节 与 docs/DECISIONS.md D-19）。
# 所以在这里改值不会影响运行 —— 要生效请在 Windows 的
# 「系统属性 → 环境变量」里设置，或在命令行用 setx：
#     setx LLM_API_KEY "<你的密钥>"        # 用户级；设完必须新开终端
#     setx LLM_API_KEY "<你的密钥>" /M     # 系统级；要管理员
# 已经在跑的服务不会自己更新，要重启。
#
# 本文件列在这里，只为回答"有哪些键、叫什么名字"。
# 只放空值与占位值，**禁止写入真实密钥**。
# ============================================================

# ---- 应用 ----
APP_NAME=AI Data Analyst Agent
APP_VERSION=0.1.0
# 上传文件落地目录（相对项目根目录）
UPLOAD_DIR=data/uploads
# 应用临时目录（相对项目根目录）。服务启动时会把 TEMP/TMP/TMPDIR 指到这里，
# 让 Starlette 解析大文件时的临时文件、matplotlib 缓存都留在项目内。
# 换台机器行为一致；目录不可写会让服务启动失败（而不是悄悄换个地方）。
TEMP_DIR=.tmp
# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=10
# 数据行数上限 / 列数上限
# 字节数挡不住"很小但很宽/很长"的文件：200 列 × 20 万行的 CSV 可能只有 3 MB
MAX_ROWS=200000
MAX_COLUMNS=200

# ---- 图表 ----
# 生成的 PNG 落地目录（相对项目根目录），由接口 8 按文件名提供
CHARTS_DIR=data/charts

# ---- 大模型（第四阶段才真正用到，现在留空即可）----
# 三个字段各认两个名字，**前面的优先**（顺序写死在 app/config.py 的 AliasChoices）：
#   llm_base_url  ← LLM_BASE_URL / DEEPSEEK_BASE_URL
#   llm_model     ← LLM_MODEL    / DEEPSEEK_MODEL     （留空 = 默认 deepseek-flash）
#   llm_api_key   ← LLM_API_KEY  / DEEPSEEK_API_KEY
# 两个名字都给时 LLM_* 赢；机器上只配了 DeepSeek 官方名也能被认出来。
# 任何兼容 OpenAI Chat Completions 协议的服务都可以，本项目按 DeepSeek 官方 API 开发并实测：
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-flash
# 注意模型名：DeepSeek 当前的对话模型叫 deepseek-flash（另有 deepseek-v4-pro）。
# 旧文档里的 deepseek-chat / deepseek-v4-flash 已不是推荐写法。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 单次模型请求超时（秒）
LLM_TIMEOUT_SECONDS=60
# 模型调用失败后的最大重试次数（不含首次）
LLM_MAX_RETRIES=2
# 整条工作流的时长上限（秒）。超过后轮询接口会把状态标成 FAILED(WORKFLOW_TIMEOUT)。
# 模型超时重试可能叠很多次，所以这里必须再兜一层，否则前端会一直转圈。
MAX_WORKFLOW_SECONDS=180
# 一条工作流允许的模型工具调用总数上限。防止模型来回调用停不下来（也就防住了无限花钱）。
TOOL_CALL_LIMIT=20
