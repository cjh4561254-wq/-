# ============================================================
# 复制这个文件为 .env，然后填入你自己的真实值：
#   Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，永远不会提交到 git。
# 本文件只放占位符，禁止写入真实密钥。
# ============================================================

# ---- 应用 ----
APP_NAME=AI Data Analyst Agent
APP_VERSION=0.1.0
# 上传文件落地目录（相对项目根目录）
UPLOAD_DIR=data/uploads
# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=10

# ---- 大模型（第四阶段才真正用到，现在留空即可）----
# 任何兼容 OpenAI Chat Completions 协议的服务都可以填在这里
# 例如 DeepSeek:  https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 单次模型请求超时（秒）
LLM_TIMEOUT_SECONDS=60
# 模型调用失败后的最大重试次数（不含首次）
LLM_MAX_RETRIES=2
